PORT=8081
MONGO_URI=mongodb://127.0.0.1:27017/quanlyhoso
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Chuỗi ngẫu nhiên dài, tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Mật khẩu cho tài khoản demo khi chạy npm run seed (mặc định 123456)
SEED_PASSWORD=

# Gửi email thông tin tài khoản khi quản trị tạo tài khoản mới (để trống = không gửi).
# Gmail: bật Xác minh 2 bước rồi tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Tên hiển thị người gửi (mặc định: Hệ thống Quản lý Hồ sơ <SMTP_USER>)
MAIL_FROM=
# Địa chỉ trang web dùng cho nút "Đăng nhập" và link "Quên mật khẩu" trong email
APP_URL=http://localhost:8080

# Tệp đính kèm lưu trong MongoDB (GridFS). UPLOAD_DIR chỉ dùng để đọc tệp cũ đã lưu trên đĩa ở bản trước.
UPLOAD_DIR=uploads

# --- Khi deploy (Render…) ---
# Chạy sau reverse proxy: số proxy phía trước (Render: 1) để giới hạn đăng nhập theo đúng IP người dùng.
TRUST_PROXY=
# Khoá cho dịch vụ cron bên ngoài gọi GET /api/cron/reminders (header Authorization: Bearer <CRON_SECRET>).
# Để trống = tắt API này. Tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
